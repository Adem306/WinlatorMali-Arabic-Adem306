    <string name="dxwrapper_help_content">مساعدة</string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[شرح إعداد Box64: 
        معالجة الأعلام on CALL/RET opcodes<br /><br />
        <b>0</b> : Treats CALL/RET as if it never needed flags (faster, unstable)<br />
        <b>1</b> : Most RET will need flags, most CALLS will not<br />
        <b>2</b> : All CALL/RET will need flags (slower)
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">شرح إعداد Box64: توليد -NAN like on x86</string>
    <string name="box64_env_var_help__dynarec_fastround">شرح إعداد Box64: توليد precise x86 rounding</string>
    <string name="box64_env_var_help__dynarec_x87double">شرح إعداد Box64: استخدام Float/Double for x87 emulation</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[شرح إعداد Box64: 
        Dynarec building BigBlock<br /><br />
        <b>0</b> : لا try to build block as big as possible<br />
        <b>1</b> : بناء كتلة Dynarec as big as possible<br />
        <b>2</b> : بناء كتلة Dynarec bigger (continue when block overlaps, but only for blocks in elf memory)<br />
        <b>3</b> : بناء كتلة Dynarec bigger (continue when block overlaps, for all types of memory)
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[شرح إعداد Box64: 
        محاكاة Strong Memory model<br /><br />
        <b>0</b> : لا try anything special<br />
        <b>1</b> : تمكين some Memory Barrier when writing to memory (on some MOV opcode)<br />
        <b>2</b> : All 1 plus a Memory Barrier on every write to memory using MOV<br />
        <b>3</b> : All 2 plus Memory Barrier when reading from memory and on some SSE/SSE2 opcodes
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">شرح إعداد Box64: يحدد أقصى قيمة للتقدم المسموح بها عند بناء الكتلة</string>
    <string name="box64_env_var_help__dynarec_callret">شرح إعداد Box64: تحسين CALL/RET opcodes</string>
    <string name="box64_env_var_help__dynarec_wait">شرح إعداد Box64: Defines whether or not Dynarec will wait for the FillBlock to be ready</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[شرح إعداد Box64: 
        Tweak memory barriers to reduce performance impact of strong memory emulation<br /><br />
        <b>0</b> : Use regular safe barriers<br />
        <b>1</b> : Use weak barriers for mild performance boost<br />
        <b>2</b> : Use weak barriers, additionally disable last write barriers]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[شرح إعداد Box64: 
        Generate aligned atomics only (only available on Arm64 for now).<br /><br />
        <b>0</b> : Generate unaligned atomics handling code.<br />
        <b>1</b> : Generate aligned atomics only, which is faster and smaller code size, but will cause SIGBUS for LOCK prefixed opcodes operating on aligned data addresses.]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[شرح إعداد Box64: 
        تمكين أو تعطيل the use of deferred flags.<br /><br />
        <b>0</b> : تعطيل the use of deferred flags.<br />
        <b>1</b> : تمكين the use of deferred flags.]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[شرح إعداد Box64: 
        السماح بمتابعة تشغيل a block that is unprotected and potentially dirty.<br /><br />
        <b>0</b> : Do not allow continue running a block that is unprotected and potentially dirty.<br />
        <b>1</b> : Allow continue to run a dynablock that write data in the same page as code. It can gets faster in loading time of some game but can also get unexpected crashes.<br />
        <b>2</b> : Will also, when it detect an HotPage, flag that page as NEVERCLEAN, and so it will not be write protected but Block build from that page will always be tested. It can be faster that way (but some SMC case might not be trapped).]]></string>
    <string name="show_adrenotools_unsupported">إظهار</string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[شرح إعداد Box64: 
        تمكين أو تعطيل the use of native flags.<br /><br />
        <b>0</b> : Do not use native flags.<br />
        <b>1</b> : Use native flags عند الإمكان.]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[شرح إعداد Box64: 
        تمكين x86 PAUSE emulation, may help the performance of spinlocks.<br /><br />
        <b>0</b> : Ignore x86 PAUSE instruction.<br />
        <b>1</b> : Use YIELD to emulate x86 PAUSE instruction.<br />
        <b>2</b> : Use WFI to emulate x86 PAUSE instruction.<br />
        <b>3</b> : Use SEVL+WFE to emulate x86 PAUSE instruction.
    ]]></string>
    <string name="box64_env_var_help__bleeding_edge">شرح إعداد Box64: تمكين experimental and potentially unstable Dynarec optimizations.</string>
    <string name="box64_env_var_help__jvm">شرح إعداد Box64: Optimize Dynarec for Java Virtual Machine (JVM) workloads.</string>
    <string name="box64_env_var_help__tcc">شرح إعداد Box64: تمكين TinyCC (TCC) integration for on-the-fly compilation of certain helpers.</string>
    <string name="box64_env_var_help__hotpage">شرح إعداد Box64: Defines the threshold for HotPage detection in Dynarec.</string>
    <string name="box64_env_var_help__fastfcode">شرح إعداد Box64: Use faster but less compatible code generation for floating point operations.</string>
    <string name="box64_env_var_help__avx"><![CDATA[شرح إعداد Box64: 
        AVX and AVX2 implemented, along with BMI1, BMI2, ADX, FMA, F16C and RDANDR extension!<br /><br />
        <b>0</b> : تعطيل AVX extension<br />
        <b>1</b> : enable AVX, BMI1, F16C and VAES extension.<br />
        <b>2</b> : All 1 plus enable AVX2, BMI2, FMA, ADX,VPCLMULQDQ and RDRAND.<br />\
    ]]></string>
    <string name="box64_env_var_help__sse42">شرح إعداد Box64: تمكين أو تعطيل SSE4.2 instruction set emulation.</string>
    <string name="box64_env_var_help__sha">شرح إعداد Box64: تمكين أو تعطيل SHA instruction set extensions.</string>
    <string name="box64_env_var_help__futex_waitv">شرح إعداد Box64: Use the futex_waitv syscall for better synchronization performance (requires Kernel 5.16+).</string>
    <string name="box64_env_var_help__dynarec_gdb">شرح إعداد Box64: تمكين GDB stub for debugging Dynarec generated code.</string>
    <string name="box64_env_var_help__dynarec_strongmem_page"><![CDATA[شرح إعداد Box64: 
        Strong memory emulation per page<br /><br />
        <b>0</b> : تعطيلd<br />
        <b>1</b> : تمكينd for code pages<br />
        <b>2</b> : تمكينd for all pages
    ]]></string>
